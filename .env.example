# Copy to .env and fill in what you need. Never commit .env.

PORT=3000
# Public URL, used in share cards. Empty is fine locally.
PUBLIC_URL=

# Robinhood Chain RPC. The public one works for testing; use a paid one in production.
RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Elysium RPC (optional, on-demand checks)
ELYSIUM_RPC_URL=https://rpc.elysium.kinetiq.xyz

# AI review of the project's site. One key is enough; DeepSeek wins if both are set.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
ANTHROPIC_API_KEY=

# Background check of new Pons launches. off to disable.
LAUNCH_WATCHER=on
ELYSIUM_WATCHER=off

# $TELL token address; empty = holder perks off
TELL_TOKEN=
TELL_HOLDER_MIN=100000
FREE_CHECKS_PER_DAY=0

# Agent API (/api/v1, /mcp): free full checks per caller per day, then x402
FREE_FULL_PER_DAY=5

# x402 in USDG on Robinhood Chain. Empty PAY_TO = payments off.
X402_PAY_TO=
X402_PRICE_FULL=0.03
# Key of a SEPARATE wallet holding only a little ETH for gas (it settles USDG transfers)
X402_SETTLER_KEY=
X402_FACILITATOR_URL=

# Proof ledger: wallet that anchors the hourly Merkle root. Empty = uses X402_SETTLER_KEY
PROOF_KEY=

# Telegram bot (token from @BotFather) and the channel for the launch feed
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=
